{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pytest: all tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Pytest: e2e (happy path)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-m", "e2e"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Pytest: headless",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [],
            "env": { "HEADLESS": "true" },
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}
