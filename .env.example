# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Credentials ───────────────────────────────────────────
LOGIN_MOBILE=9990511718
LOGIN_OTP=your_otp_here

# ── Lead Creation ─────────────────────────────────────────
LEAD_FIRST_NAME=                # leave empty to pick a random name each run
LEAD_LAST_NAME=                 # leave empty to pick a random name each run
LEAD_DUPLICATE_MOBILE=9275620745
LEAD_LOAN_TYPE=Home Loan        # Home Loan | LAP
LEAD_LOAN_SUB_TYPE=Balance Transfer
LEAD_EMPLOYMENT_TYPE=Salaried   # e.g. Salaried | Self Employed (confirm exact option text on the form)
LEAD_STATE_SEARCH=haryana
LEAD_STATE_OPTION=Haryana
LEAD_CITY_SEARCH=gurgaon
LEAD_CITY_OPTION=Gurgaon

# ── Move To Login ─────────────────────────────────────────
LOGIN_LEAD_ID=162981
LOGIN_AMOUNT=10000000
LOGIN_DATE=                     # YYYY-MM-DD; leave empty to use today
LOGIN_BANK_SEARCH=icici
LOGIN_BANK_NAME=ICICI Bank
LOGIN_BRANCH=testing
LOGIN_BANKER=test@icicibank.com

# ── Move To Sanction ──────────────────────────────────────
SANCTION_LEAD_ID=162966
SANCTION_AMOUNT=10000000
SANCTION_DATE=                  # YYYY-MM-DD; leave empty to use today
SANCTION_BRANCH=testing
SANCTION_BANKER=test@icicibank.com

# ── Move To Disburse ──────────────────────────────────────
DISBURSE_LEAD_ID=115653
DISBURSE_AMOUNT=10000000
DISBURSE_DATE=                  # YYYY-MM-DD; leave empty to use today
DISBURSE_BANK_SEARCH=icici
DISBURSE_BANK_NAME=ICICI Bank
DISBURSE_BRANCH=testing
DISBURSE_BANKER=test@icicibank.com

# ── Add Role ──────────────────────────────────────────────
ROLE_NAME=                      # leave empty to generate a unique name each run
ROLE_DESCRIPTION=Test role - automated test run

# ── Raise a Query ─────────────────────────────────────────
QUERY_ISSUE=Lead/Case issue
QUERY_SUBISSUE=Incorrect Details
QUERY_DESCRIPTION=Test query - please ignore. Automated test run.

# ── Payout Calculator ─────────────────────────────────────
PAYOUT_LOAN_AMOUNT=1000000
PAYOUT_PRODUCT_TYPE=Home Loan
PAYOUT_FULFILMENT_TYPE=I will do it myself

# ── Check Offers ──────────────────────────────────────────
CHECK_OFFERS_FIRST_NAME=            # leave empty to pick a random name each run
CHECK_OFFERS_LAST_NAME=             # leave empty to pick a random name each run
CHECK_OFFERS_EMPLOYMENT_TYPE=Salaried
CHECK_OFFERS_LOAN_TYPE=Home Loan
CHECK_OFFERS_LOAN_AMOUNT=1000000
CHECK_OFFERS_TENURE=9
CHECK_OFFERS_AGE_RANGE=-40 yrs

# ── Email Report (optional) ───────────────────────────────
# When REPORT_EMAIL_TO is set, every pytest run (one test, one file, or the
# full suite) ends with a "Send report email? [y/N]" prompt (--email/--no-email
# bypass it). Sends: a rendered summary in the body, reports.zip (test-summary,
# log-report, allure-report) + test-report.xlsx attached. See README "Email Report".
# Leave REPORT_EMAIL_TO empty to disable entirely.
# For Gmail/Workspace, REPORT_EMAIL_PASSWORD must be a 16-char App Password
# (Google Account → Security → 2-Step Verification → App passwords), NOT your
# normal login password.
REPORT_EMAIL_TO=                # comma-separated recipient(s), e.g. you@ambak.com
REPORT_EMAIL_USER=              # the sending Gmail/Workspace account
REPORT_EMAIL_PASSWORD=          # 16-char Google App Password
# REPORT_EMAIL_FROM=            # defaults to REPORT_EMAIL_USER
# REPORT_EMAIL_HOST=smtp.gmail.com
# REPORT_EMAIL_PORT=587

# ── Browser (optional) ────────────────────────────────────
# BROWSER=chromium
# HEADLESS=false
# SLOW_MO=0
# TIMEOUT=30000
